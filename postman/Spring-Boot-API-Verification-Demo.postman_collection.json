{
  "info": {
    "name": "Spring Boot API Verification Demo",
    "description": "Requests and assertions for the User Management API. Run the whole collection in order with the Collection Runner; every request carries tests for its expected status and error type. See docs/verification-scenarios.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Create valid user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Verma\",\n  \"email\": \"{{email}}\",\n  \"age\": 30,\n  \"status\": \"ACTIVE\"\n}"
            },
            "description": "Creates a user with a unique email per run and stores its id in {{userId}}."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", `asha.verma.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test(\"Location header points to new user\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(`/api/users/${body.id}`));",
                  "pm.test(\"Email is normalized to lower case\", () => pm.expect(body.email).to.eql(pm.collectionVariables.get(\"email\").toLowerCase()));",
                  "pm.test(\"createdAt equals updatedAt on creation\", () => pm.expect(body.createdAt).to.eql(body.updatedAt));",
                  "pm.collectionVariables.set(\"userId\", body.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get user by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested user\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"userId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Search user by email (case-insensitive)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/search?email={{email}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "search"
              ],
              "query": [
                {
                  "key": "email",
                  "value": "{{email}}"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Upper-case the stored email to prove the lookup is case-insensitive",
                  "pm.variables.set(\"email\", pm.collectionVariables.get(\"email\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Finds the created user\", () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"userId\"))));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "{{userId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Asha Rao\",\n  \"email\": \"{{email}}\",\n  \"age\": 31,\n  \"status\": \"INACTIVE\"\n}"
            },
            "description": "Keeps the same email, which must be allowed (the uniqueness check excludes the user being updated)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test(\"Fields are updated\", () => {",
                  "    pm.expect(body.name).to.eql(\"Asha Rao\");",
                  "    pm.expect(body.age).to.eql(31);",
                  "    pm.expect(body.status).to.eql(\"INACTIVE\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
